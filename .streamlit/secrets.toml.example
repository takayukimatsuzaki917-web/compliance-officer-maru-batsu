# =============================================================
# Streamlit の Secrets（秘密情報）の設定例
#   - ローカルで使う場合: このファイルを .streamlit/secrets.toml にコピーして値を書き換える
#     （secrets.toml は .gitignore 対象。GitHub に上げないこと）
#   - Streamlit Community Cloud で使う場合: アプリの Settings → Secrets に同じ内容を貼り付ける
#   - どちらも設定しない場合: パスワードなし・履歴はローカルの history.json に保存
# =============================================================

[app]
# アプリを開くときのパスワード（空にするとパスワードなし）
password = "ここにパスワード"

[github]
# GitHub Gist の読み書き権限（Gists: Read and write）を持つアクセストークン
token = "github_pat_xxxxxxxxxxxxxxxx"
# 履歴を保存する Gist の id（https://gist.github.com/ユーザー名/【この部分】）
gist_id = "0123456789abcdef0123456789abcdef"
# Gist 内のファイル名（省略時は history.json）
filename = "history.json"
